generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  controller
  hod
  qpsetter
}

enum Affiliation {
  internal
  external
}

enum AssignmentStatus {
  Pending
  Submitted
  Approved
  RevisionRequired
}

enum SchemeStatus {
  Draft
  Finalized
}

enum NotificationType {
  info
  success
  warning
  error
}

enum NotificationKind {
  suggestion
  assignment
  approval
  revision
  general
}

enum BloomsLevel {
  L1
  L2
  L3
  L4
  L5
  L6
}

enum QuestionStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  REVISION_REQUESTED
  RETIRED
}

// ─── User ────────────────────────────────────────────────

model User {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  passwordHash  String
  role          Role
  name          String
  title         String?      // Controller title / HOD designation title
  dept          String?      // Department — used by HOD & faculty
  departmentId  Int?
  department    Department?  @relation("DeptUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  email         String?      @unique
  phone         String?
  qualification String?
  experience    String?
  joinDate      DateTime?
  designation   String?
  affiliation   Affiliation?
  college       String?
  registeredBy  String?
  registeredOn  DateTime?
  hodId         Int?
  hod           User?        @relation("HodFaculty", fields: [hodId], references: [id])
  faculty       User[]       @relation("HodFaculty")

  // Assignment relations
  assignedWork         Assignment[]   @relation("FacultyAssignments")
  hodAssignments       Assignment[]   @relation("HodAssignments")
  createdAssignments   Assignment[]   @relation("AssignerAssignments")

  // Academic & Question Bank relations
  headedDepartments    Department[]      @relation("DeptHod")
  authoredQuestions    Question[]        @relation("QuestionAuthor")
  authoredVersions     QuestionVersion[] @relation("QuestionVersionAuthor")
  reviewsGiven         QuestionReview[]  @relation("ReviewAuthor")

  // Other relations
  notifications        Notification[] @relation("UserNotifications")
  sentNotifications    Notification[] @relation("NotificationSender")
  courses              Course[]
  schemes              Scheme[]
  suggestions          Suggestion[]   @relation("SuggestionAuthor")
  refreshTokens        RefreshToken[]

  failedAttempts Int          @default(0)
  lockoutUntil   DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([hodId])
  @@index([departmentId])
  @@index([role])
}

// ─── Course ──────────────────────────────────────────────

model Course {
  id               Int          @id @default(autoincrement())
  courseName       String
  courseCode       String
  semester         String
  schemeYear       String
  credits          Int
  examTypes        String[]
  syllabusFileName String?
  bos              String       // Board of Studies
  hodId            Int
  hod              User         @relation(fields: [hodId], references: [id])

  departmentId     Int?
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assignments      Assignment[]
  schemes          Scheme[]
  offerings        CourseOffering[]
  courseOutcomes   CourseOutcome[]
  questions        Question[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([courseCode, semester, schemeYear])
  @@index([hodId])
  @@index([departmentId])
}

// ─── Scheme (QP Blueprint) ───────────────────────────────

model Scheme {
  id          Int          @id @default(autoincrement())
  courseId    Int
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  examType    String
  rows        SchemeRow[]
  status      SchemeStatus @default(Draft)
  hodId       Int
  hod         User         @relation(fields: [hodId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([courseId, examType])
  @@index([hodId])
}

// ─── Scheme Row ──────────────────────────────────────────

model SchemeRow {
  id             Int    @id @default(autoincrement())
  schemeId       Int
  scheme         Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  questionNo     String
  part           String
  maxMarks       Int
  expectedPoints String
  co             String
  bloomsLevel    String
}

// ─── Assignment ──────────────────────────────────────────

model Assignment {
  id                Int              @id @default(autoincrement())
  assessmentCode    String           @unique  // e.g. "1IA_6Sem_May2026_21CS32"
  description       String?
  assessmentId      Int?
  assessment        Assessment?      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  facultyId         Int?
  faculty           User?            @relation("FacultyAssignments", fields: [facultyId], references: [id], onDelete: Restrict)

  hodId             Int?
  hod               User?            @relation("HodAssignments", fields: [hodId], references: [id], onDelete: SetNull)

  courseId           Int
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)

  examType          String
  startDate         DateTime?
  dueDate           DateTime
  status            AssignmentStatus @default(Pending)
  assignedDate      DateTime
  instructions      String?
  revisionComment   String?

  syllabusFileName  String?
  prevPaperFileName String?
  timetableFileName String?

  assignedById      Int?
  assignedBy        User?            @relation("AssignerAssignments", fields: [assignedById], references: [id], onDelete: SetNull)

  suggestions       Suggestion[]
  paper             QuestionPaper?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([facultyId])
  @@index([hodId])
  @@index([courseId])
  @@index([status])
  @@index([assignedById])
}

// ─── Suggestion ──────────────────────────────────────────

model Suggestion {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fromUserId   Int
  fromUser     User       @relation("SuggestionAuthor", fields: [fromUserId], references: [id])
  message      String
  date         DateTime   @default(now())

  @@index([assignmentId])
}

// ─── Question Paper ──────────────────────────────────────

model QuestionPaper {
  id           Int        @id @default(autoincrement())
  assignmentId Int        @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  content      Json
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── Notification ────────────────────────────────────────

model Notification {
  id           Int              @id @default(autoincrement())
  userId       Int
  user         User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  message      String
  date         DateTime         @default(now())
  read         Boolean          @default(false)
  type         NotificationType @default(info)
  kind         NotificationKind @default(general)
  assignmentId Int?
  fromUserId   Int?
  fromUser     User?            @relation("NotificationSender", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, read])
}

// ─── Refresh Token ───────────────────────────────────────

model RefreshToken {
  id         String    @id @default(uuid())
  familyId   String
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  revoked    Boolean   @default(false)
  expiresAt  DateTime
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// ─── Audit Log ───────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  role      Role?
  action    String
  entityId  String?
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

// ─── Assessment Master ───────────────────────────────────

model Assessment {
  id             Int          @id @default(autoincrement())
  assessmentCode String       @unique
  examType       String
  semester       String
  startDate      DateTime
  schemeYear     String?
  assignments    Assignment[]
  createdAt      DateTime     @default(now())
}

// ─── Department ──────────────────────────────────────────

model Department {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  hodId           Int?
  hod             User?            @relation("DeptHod", fields: [hodId], references: [id], onDelete: SetNull)
  courses         Course[]
  users           User[]           @relation("DeptUsers")
  courseOfferings CourseOffering[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ─── Course Offering ─────────────────────────────────────

model CourseOffering {
  id           Int         @id @default(autoincrement())
  courseId     Int
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicYear String      // e.g. "2025-2026"
  semester     String      // e.g. "6"
  schemeYear   String      // e.g. "2022"
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([courseId, academicYear, semester, schemeYear])
  @@index([courseId])
  @@index([departmentId])
}

// ─── Course Outcome (CO) ─────────────────────────────────

model CourseOutcome {
  id            Int            @id @default(autoincrement())
  courseId      Int
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coCode        String         // e.g. "CO1", "CO2"
  description   String
  targetMarks   Int?
  questionParts QuestionPart[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([courseId, coCode])
  @@index([courseId])
}

// ─── Question Master ─────────────────────────────────────

model Question {
  id               Int              @id @default(autoincrement())
  code             String           @unique // e.g. "Q-CSE-2026-0001"
  courseId         Int
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  unitNumber       Int              // VTU Unit 1..5
  topic            String
  subtopic         String?
  status           QuestionStatus   @default(DRAFT)
  authorId         Int
  author           User             @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  currentVersionNo Int              @default(1)
  versions         QuestionVersion[]
  reviews          QuestionReview[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([courseId, unitNumber])
  @@index([authorId])
  @@index([status])
}

// ─── Question Version ────────────────────────────────────

model QuestionVersion {
  id                Int            @id @default(autoincrement())
  questionId        Int
  question          Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  versionNumber     Int
  stemRichJson      Json           // TipTap JSON (rich content, LaTeX, embedded SVG data)
  plainText         String         // Plain text for searching
  contentBlindIndex String?        // HMAC-SHA256 blind index
  encryptedContent  String?        // AES-256-GCM ciphertext
  iv                String?        // 96-bit IV
  authTag           String?        // 128-bit GCM auth tag
  parts             QuestionPart[]
  createdById       Int
  createdBy         User           @relation("QuestionVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  changeLog         String?
  createdAt         DateTime       @default(now())

  @@unique([questionId, versionNumber])
  @@index([questionId])
  @@index([createdById])
  @@index([contentBlindIndex])
}

// ─── Question Part ───────────────────────────────────────

model QuestionPart {
  id                Int             @id @default(autoincrement())
  questionVersionId Int
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  partLabel         String          // e.g. "(a)", "(b)", "(c)"
  marks             Int
  bloomsLevel       BloomsLevel
  courseOutcomeId   Int?
  courseOutcome     CourseOutcome?  @relation(fields: [courseOutcomeId], references: [id], onDelete: SetNull)
  coCode            String?         // Denormalized e.g. "CO1"
  markingRubric     Json?           // Array of { stepNo: number, description: string, marks: number }
  modelAnswerJson   Json?           // Rich text / LaTeX model solution
  orderIndex        Int             @default(0)
  createdAt         DateTime        @default(now())

  @@index([questionVersionId])
  @@index([courseOutcomeId])
}

// ─── Question Review ─────────────────────────────────────

model QuestionReview {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewerId Int
  reviewer   User     @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  stage      String   // "PEDAGOGICAL", "LINGUISTIC", "BOE_FINAL"
  verdict    String   // "APPROVED", "CHANGES_REQUESTED", "REJECTED"
  comments   String
  createdAt  DateTime @default(now())

  @@index([questionId])
  @@index([reviewerId])
}

